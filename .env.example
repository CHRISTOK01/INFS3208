# Copy this file to .env and fill in your own values:  cp .env.example .env
# Docker Compose reads .env from the project folder automatically. Never commit .env to git.

# Secret used to sign login tokens (meal-logging) and check them (every service).
# It must be at least 32 characters. You can make a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# The app version shown by GET /version and in the website footer.
# Change it when you want to show off a rolling update.
APP_VERSION=1.0.0

# Each service has its own database, so each one gets its own password.
MEAL_DB_PASSWORD=meal_pw
NUTRIENT_DB_PASSWORD=nutrient_pw
GAP_DB_PASSWORD=gap_pw
RECOMMENDER_DB_PASSWORD=recommender_pw

# How much the services log: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

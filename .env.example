# Copy this file to .env and fill in your own values:  cp .env.example .env
# Docker Compose reads .env from the project folder automatically. Never commit .env to git.

# People log in through Google Cloud Identity Platform. This is the ID of your Google Cloud
# project (it's at the top of the Google Cloud console, e.g. "macroscope-123456").
# Every service only accepts logins made for this project.
GOOGLE_PROJECT_ID=your-project-id

# The "Web API key" from Identity Platform (Identity Platform > Application setup details).
# The website needs it to show Google's sign-in box. It isn't a secret: Google expects it to be
# public, because it ends up in the browser anyway.
GOOGLE_API_KEY=your-web-api-key

# Secret our services use to sign the tokens they send each other (e.g. meal-logging calling
# nutrient-calc). People's logins don't use it. It must be at least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# The app version shown by GET /version and in the website footer.
# Change it when you want to show off a rolling update.
APP_VERSION=1.0.0

# Each service has its own database, so each one gets its own password.
MEAL_DB_PASSWORD=meal_pw
NUTRIENT_DB_PASSWORD=nutrient_pw
GAP_DB_PASSWORD=gap_pw
RECOMMENDER_DB_PASSWORD=recommender_pw

# How much the services log: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

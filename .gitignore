# Your real settings and secrets. Only .env.example goes into git.
.env

# The food data files are too big for git (the USDA ones are several GB).
# Run etl/download_ausnut.py and etl/download_usda.py to get them. The .gitkeep file just keeps the
# empty folder in git.
etl/data/*
!etl/data/.gitkeep

# Database dumps (made when copying the data to the cloud)
*.dump

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node / frontend, and the submission ZIP (dist/macroscope-submission.zip)
node_modules/
dist/

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Our own helper for making the submission ZIP (not needed on GitHub)
scripts/
